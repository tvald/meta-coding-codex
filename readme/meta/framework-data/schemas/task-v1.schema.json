{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meta-coding.local/framework-data/task-v1.schema.json",
  "title": "Framework task record",
  "$comment": "Pinned structural interchange documentation. The repository-pinned CLI is authoritative for semantic, transition, path, text-safety, and cross-record validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "recordVersion",
    "taskRevision",
    "outcome",
    "authority",
    "status",
    "dependencies",
    "route",
    "risk",
    "tags",
    "gate",
    "nextSafeAction",
    "details",
    "completion"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^T-(?:000[1-9]|00[1-9][0-9]|0[1-9][0-9]{2}|[1-9][0-9]{3,})$" },
    "recordVersion": { "type": "integer", "minimum": 1 },
    "taskRevision": { "type": "integer", "minimum": 1 },
    "outcome": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "acceptedDate"],
      "properties": {
        "reference": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "acceptedDate": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
          ]
        }
      }
    },
    "status": {
      "enum": [
        "pending",
        "ready",
        "active",
        "parked",
        "blocked",
        "needs_verification",
        "done",
        "cancelled",
        "superseded"
      ]
    },
    "dependencies": {
      "type": "array",
      "maxItems": 1000,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^T-(?:000[1-9]|00[1-9][0-9]|0[1-9][0-9]{2}|[1-9][0-9]{3,})$" }
    },
    "route": {
      "enum": [
        "unrouted",
        "quick_change",
        "clarify",
        "discover",
        "decide",
        "initiative",
        "correct_course"
      ]
    },
    "risk": {
      "oneOf": [
        { "type": "null" },
        { "enum": ["low", "medium", "high", "critical"] }
      ]
    },
    "tags": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
      }
    },
    "gate": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "none" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "summary"],
          "properties": {
            "kind": { "const": "blocker" },
            "summary": { "type": "string", "minLength": 1, "maxLength": 4096 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "summary",
            "id",
            "status",
            "boundTaskRevision",
            "source",
            "action",
            "boundary",
            "detailPath"
          ],
          "properties": {
            "kind": { "const": "approval" },
            "summary": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1, "maxLength": 4096 }] },
            "id": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1, "maxLength": 256 }] },
            "status": { "enum": ["pending", "granted", "denied", "expired", null] },
            "boundTaskRevision": { "type": "integer", "minimum": 1 },
            "source": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1, "maxLength": 4096 }] },
            "action": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1, "maxLength": 4096 }] },
            "boundary": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1, "maxLength": 4096 }] },
            "detailPath": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1, "maxLength": 1024 }] }
          }
        }
      ]
    },
    "nextSafeAction": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1, "maxLength": 8192 }] },
    "details": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "path"],
        "properties": {
          "label": { "type": "string", "minLength": 1, "maxLength": 256 },
          "path": { "type": "string", "minLength": 1, "maxLength": 1024 }
        }
      }
    },
    "completion": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["completedAt", "repositoryChanged", "evidence"],
          "properties": {
            "completedAt": {
              "oneOf": [
                { "type": "null" },
                { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
              ]
            },
            "repositoryChanged": { "type": ["boolean", "null"] },
            "evidence": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1, "maxLength": 8192 }] }
          }
        }
      ]
    }
  }
}
