{
  "name": "@tvald/meta-framework",
  "version": "1.0.0",
  "description": "Immutable, repository-backed operating framework for AI-assisted software development",
  "type": "module",
  "metaFramework": {
    "taskCli": {
      "version": "1.0.0",
      "envelopeVersions": [
        1
      ],
      "readableStoreSchemaVersions": [
        1
      ],
      "writableStoreSchemaVersions": [
        1
      ]
    },
    "providerProbe": {
      "version": "1.0.0",
      "envelopeVersions": [
        1
      ],
      "harnesses": [
        "claude",
        "codex"
      ],
      "capabilities": [
        "delegation"
      ]
    },
    "promptCompiler": {
      "version": "1.0.0",
      "envelopeVersions": [
        1
      ],
      "promptFormatVersions": [
        1
      ],
      "registrySchemaVersions": [
        1
      ],
      "extensionManifestVersions": [
        1
      ],
      "extensionApiVersions": [
        1
      ],
      "profiles": [
        "implementer",
        "qa",
        "reviewer",
        "root",
        "security"
      ],
      "harnesses": [
        "claude",
        "codex",
        "portable"
      ]
    },
    "projectInit": {
      "version": "1.1.0",
      "envelopeVersions": [
        1
      ],
      "bootstrapVersions": [
        1
      ],
      "stateTemplateVersions": [
        1
      ],
      "optionalHarnesses": [
        "codex"
      ],
      "codexIntegrationConfigVersions": [
        1
      ]
    },
    "hookAdapter": {
      "version": "1.0.0",
      "envelopeVersions": [
        1
      ],
      "hookEventSchemaVersions": [
        1
      ],
      "integrationConfigVersions": [
        1
      ],
      "harnesses": [
        "codex"
      ],
      "profiles": [
        "implementer",
        "qa",
        "reviewer",
        "root",
        "security"
      ],
      "testedCodexVersions": [
        "0.147.0"
      ]
    }
  },
  "bin": {
    "meta-framework": "bin/meta-framework.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "package-files.json",
    "prompts/",
    "readme/meta/"
  ],
  "scripts": {
    "meta": "node ./bin/meta-framework.mjs",
    "package:check": "node scripts/check-npm-package.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:package": "node --test tests/hook-adapters.test.mjs tests/npm-package.test.mjs tests/package-task-cli.test.mjs tests/project-initializer.test.mjs tests/prompt-compiler.test.mjs tests/prompt-extensions.test.mjs tests/provider-adapters.test.mjs",
    "test:prompt": "node --test tests/prompt-compiler.test.mjs",
    "test:provider": "node --test tests/provider-adapters.test.mjs",
    "test:tasks": "node --test tests/package-task-cli.test.mjs"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tvald/meta-coding-codex.git"
  },
  "bugs": {
    "url": "https://github.com/tvald/meta-coding-codex/issues"
  },
  "homepage": "https://github.com/tvald/meta-coding-codex#readme",
  "keywords": [
    "ai-agents",
    "codex",
    "development-workflow",
    "task-orchestration"
  ],
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public"
  }
}
